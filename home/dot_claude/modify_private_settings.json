{{- /* chezmoi:modify-template */ -}}
{{- $in := default "{}" .chezmoi.stdin -}}
{{- $current := fromJson $in -}}
{{- $managed := dict
  "$schema" "https://json.schemastore.org/claude-code-settings.json"
  "permissions" (dict "allow" (list
    "mcp__opencode_proxy__bash"
    "mcp__opencode_proxy__edit"
    "mcp__opencode_proxy__write"
    "mcp__opencode_proxy__webfetch"
    "mcp__opencode_proxy__task"
    "mcp__context7"
    "mcp__zhtw-mcp__zhtw"
    "WebSearch"
  ))
  "env" (dict "CLAUDE_CODE_PLUGIN_KEEP_MARKETPLACE_ON_FAILURE" "1")
  "enabledPlugins" .ai.claude.plugins
  "extraKnownMarketplaces" .ai.claude.marketplaces
  "theme" "auto"
  "verbose" true
  "skipAutoPermissionPrompt" true
-}}
{{- /* 整個取代，否則從 ai.yaml 移除的 plugin 會被深層合併留下 */ -}}
{{- $base := omit (deepCopy $current) "enabledPlugins" "extraKnownMarketplaces" -}}
{{- $patched := mergeOverwrite $base $managed -}}
{{- if eq (toJson $current) (toJson $patched) -}}
{{ $in }}
{{- else -}}
{{ $patched | toPrettyJson }}
{{- end -}}
