{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu
# Apply native menu bar preferences before starting the apps.
defaults write com.steipete.codexbar mergeIcons -bool false
defaults write com.stonerl.Thaw EnableNativeAppHiding -bool true
defaults write local.WorkspaceStatus compactViewEnabled -bool true
defaults write local.WorkspaceStatus dockBadgesEnabled -bool false
defaults write local.WorkspaceStatus menuBarPosition -string system
defaults write com.apple.menuextra.clock ShowDate -int 2
defaults write -g _HIHideMenuBar -bool false
defaults write com.apple.controlcenter AutoHideMenuBarOption -int 3
{{- end }}
