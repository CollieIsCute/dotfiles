#!/bin/bash
set -euo pipefail

GREEN='\033[1;32m'
NC='\033[0m'

{{ if eq .chezmoi.os "darwin" }}
  echo -e "${GREEN}Installing MacOS packages${NC}"
  {{- template "install-packages_darwin.tmpl" . -}}

{{ else if eq .chezmoi.os "linux" }}
  {{- $osid := .chezmoi.osRelease.id -}}
  {{ if eq $osid "arch" }}
    sudo rm -f /etc/lsb-release
    echo -e "${GREEN}Installing packages for {{ $osid }}...${NC}"
    {{ if .packages.arch.paru }}
    # Use -Syu to ensure system is up-to-date and libalpm version matches paru
    sudo pacman -Syu --noconfirm
    paru -S --needed --noconfirm {{ range .packages.arch.paru }}{{ . }} {{ end }}
    {{ end }}
    
    if command -v flatpak > /dev/null; then
      echo -e "${GREEN}Setting up Flatpak and installing applications...${NC}"
      
      flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
      
      echo -e "${GREEN}Installing Bottles via Flatpak...${NC}"
      flatpak install --user --noninteractive -y flathub com.usebottles.bottles
      
      echo -e "${GREEN}Flatpak setup complete.${NC}"
    else
      echo -e "${GREEN}Flatpak not found, skipping Flatpak app installation${NC}"
    fi
  {{ else if eq $osid "ubuntu" }}
    echo -e "${GREEN}Installing packages for Ubuntu...${NC}"
    {{ if .packages.ubuntu.apt }}
    sudo apt-get -o Acquire::Retries=3 update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=3 install -y {{ range .packages.ubuntu.apt }}{{ . }} {{ end }}
    {{ end }}
  {{ else }}
    echo "Unsupported Linux distro: {{ $osid }}"
    exit 1
  {{ end }}
{{ else }}
  echo "Unsupported OS: {{ .chezmoi.os }}"
  exit 1
{{ end }}

echo -e "${GREEN}Package installation complete!${NC}"
