#!/bin/sh
# fish_plugins hash: {{ include "dot_config/fish/fish_plugins" | sha256sum }}
set -e

command -v fish >/dev/null || exit 0

if ! fish -c 'type -q fisher'; then
  exec fish -c 'curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source; and fisher update; and fisher list jorgebucaran/fisher >/dev/null'
fi

if ! fish -c 'fisher list jorgebucaran/fisher' >/dev/null; then
  # Register orphaned bootstraps without conflicting with fisher.fish.
  fisher_stage=$(mktemp -d)
  fisher_path="$fisher_stage" fish -c 'fisher install jorgebucaran/fisher'
  rm -r "$fisher_stage"
fi

fish -c 'fisher update; and fisher list jorgebucaran/fisher >/dev/null'
