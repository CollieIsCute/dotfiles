#!/bin/bash
set -euo pipefail

export GREEN='\033[1;32m'
export NC='\033[0m'

echo -e "\n${GREEN}Setting up package manager...${NC}"
{{- if eq .chezmoi.os "darwin" }}
  echo -e "${GREEN}macOS detected, configuring Homebrew...${NC}"
  
  if ! command -v brew &> /dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [[ -x /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    else
      eval "$(/usr/local/bin/brew shellenv)"
    fi
  fi

{{ else if eq .chezmoi.os "linux" }}
  {{- $osid := .chezmoi.osRelease.id -}}
  {{ if eq $osid "arch" }}
    # Setup system configurations
    enable_multilib() {
      sudo sed -i '/#\[multilib\]/,/#Include/ s/#//' /etc/pacman.conf
      if ! grep -q '^[[:space:]]*\[multilib\]' /etc/pacman.conf; then
        printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' | sudo tee -a /etc/pacman.conf > /dev/null
      fi
    }

    echo -e "${GREEN}Setting up mirrorlist${NC}"
    # Static mirrorlist with globally distributed mirrors (Asia-optimized order)
    # Deterministic approach: no network dependency on archlinux.org API
    sudo tee /etc/pacman.d/mirrorlist > /dev/null << 'MIRRORLIST'
# Arch Linux mirrorlist - static, deterministic, Asia-optimized
# Generated by chezmoi dotfiles

# Official Arch CDN with geo-routing
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch

# xTom - excellent Asia coverage (HK, Tokyo, Singapore)
Server = https://mirrors.xtom.com/archlinux/$repo/os/$arch

# Fastly CDN (official sponsor)
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch

# Rackspace - global CDN
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch

# kernel.org - reliable fallback
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
MIRRORLIST
    echo -e "${GREEN}Mirrorlist configured with static mirrors${NC}"

    echo -e "${GREEN}Configuring pacman settings${NC}"
    sudo sed -i 's/#ParallelDownloads = 5/ParallelDownloads = 10/g' /etc/pacman.conf
    enable_multilib
    echo -e "${GREEN}Upgrading system packages (including pacman/libalpm)${NC}"
    sudo pacman -Syu --noconfirm

    echo -e "${GREEN}Installing/upgrading paru from source...${NC}"
    
    # Build paru from source to ensure it matches the current libalpm version
    # Using paru (not paru-bin) because pre-compiled binaries may be built against
    # an older libalpm version, causing "libalpm.so.X: cannot open shared object file" errors
    sudo pacman -S --needed --noconfirm base-devel git rust

    paru_build_dir="$(mktemp -d)"
    trap 'rm -rf -- "$paru_build_dir"' EXIT
    git clone --depth=1 https://aur.archlinux.org/paru.git "$paru_build_dir/paru"
    (cd "$paru_build_dir/paru" && makepkg -si --noconfirm)
    
    echo -e "${GREEN}paru installed successfully!${NC}"
  {{ else if eq $osid "ubuntu" }}
    echo -e "${GREEN}Ubuntu needs no package-manager bootstrap.${NC}"
  {{ else }}
    echo "Unsupported Linux distro: {{ $osid }}"
    exit 1
  {{ end }}
{{ else }}
  echo "Unsupported OS: {{ .chezmoi.os }}"
  exit 1
{{ end }}

echo -e "${GREEN}setup package manager complete!${NC}"
