{{ if and (ne .chezmoi.os "windows") (not (includeTemplate "is_wsl" . | fromJson)) -}}
#!/bin/sh
set -eu

# Stop the old model server before chezmoi removes its binaries and models.
{{ if eq .chezmoi.os "linux" -}}
systemctl --user stop crispasr.service 2>/dev/null || true
{{ else if eq .chezmoi.os "darwin" -}}
launchctl remove com.collie.crispasr 2>/dev/null || true
{{ end -}}

# asr-mode honored XDG_CACHE_HOME; the default cache is in .chezmoiremove.
if [ -n "${XDG_CACHE_HOME:-}" ]; then
  rm -f -- "$XDG_CACHE_HOME/crispasr/sensevoice-small-q8_0.gguf" \
    "$XDG_CACHE_HOME/crispasr/qwen3-asr-1.7b-q8_0.gguf"
fi
{{ end -}}
