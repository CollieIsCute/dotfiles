local wezterm = require 'wezterm'
local config = wezterm.config_builder()
config.max_fps      = 170
config.ssh_domains  = {}
config.harfbuzz_features = { 'liga=1' }
config.enable_tab_bar = false

{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
config.color_scheme = 'Noctalia'
{{ else -}}
config.color_scheme = 'Catppuccin Mocha'
{{ end -}}

-- Font configuration
config.font = wezterm.font('JetBrainsMono Nerd Font', { weight = 'Regular' })
config.font_size = 12.0

-- Pass pane navigation/resizing to tmux and Neovim.
config.keys = {
  { key = 'LeftArrow', mods = 'CTRL', action = wezterm.action.SendString '\x1b[1;5D' },
  { key = 'DownArrow', mods = 'CTRL', action = wezterm.action.SendString '\x1b[1;5B' },
  { key = 'UpArrow', mods = 'CTRL', action = wezterm.action.SendString '\x1b[1;5A' },
  { key = 'RightArrow', mods = 'CTRL', action = wezterm.action.SendString '\x1b[1;5C' },
  { key = 'LeftArrow', mods = 'ALT', action = wezterm.action.SendString '\x1b[1;3D' },
  { key = 'DownArrow', mods = 'ALT', action = wezterm.action.SendString '\x1b[1;3B' },
  { key = 'UpArrow', mods = 'ALT', action = wezterm.action.SendString '\x1b[1;3A' },
  { key = 'RightArrow', mods = 'ALT', action = wezterm.action.SendString '\x1b[1;3C' },
}

return config
