# macOS-only targets.
{{- if ne .chezmoi.os "darwin" }}
.config/aerospace
.config/aerospace/**
.config/brew
.config/brew/**
.config/karabiner
.config/karabiner/**
Library
Library/**
{{- end }}

# Linux desktop / XDG targets.
{{- if ne .chezmoi.os "linux" }}
.config/BraveSoftware
.config/BraveSoftware/**
.config/brave-origin-flags.conf
.config/code-flags.conf
.config/electron-flags.conf
.config/environment.d
.config/environment.d/**
.config/hypr
.config/hypr/**
.config/mimeapps.list
.config/noctalia
.config/noctalia/**
.config/open-whispr
.config/open-whispr/**
.config/paru
.config/paru/**
.local/share/applications
.local/share/applications/**
{{- else if ne .chezmoi.osRelease.id "arch" }}
.config/paru
.config/paru/**
{{- end }}

# Noctalia-managed Qt colors are Arch-only.
{{- if not (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch")) }}
.config/qt6ct
.config/qt6ct/**
{{- end }}

# Matugen owns non-Linux palette generation.
{{- if not (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows")) }}
.chezmoiscripts/6-apply-theme.sh
.config/matugen
.config/matugen/**
{{- end }}

# Run scripts are platform-specific.
{{- if eq .chezmoi.os "windows" }}
.chezmoiscripts/*.sh
.local/bin/chezmoi-theme
{{- else }}
.chezmoiscripts/*.ps1
.local/bin/chezmoi-theme.cmd
{{- end }}
