{{- $isWSL := includeTemplate "is_wsl" . | fromJson -}}
# macOS-only targets.
{{- if ne .chezmoi.os "darwin" }}
.config/aerospace
.config/aerospace/**
.config/brew
.config/brew/**
.config/karabiner
.config/karabiner/**
.config/sketchybar
.config/sketchybar/**
Library
Library/**
{{- end }}

# Windows voice settings and commands.
{{- if ne .chezmoi.os "windows" }}
AppData
AppData/**
.local/bin/asr-mode.cmd
.local/libexec/asr-mode.ps1
{{- end }}

# Linux desktop / XDG targets.
{{- if or (ne .chezmoi.os "linux") $isWSL }}
.local/bin/openwhispr
.config/BraveSoftware
.config/BraveSoftware/**
.config/brave-origin-flags.conf
.config/code-flags.conf
.config/electron-flags.conf
.config/environment.d
.config/environment.d/**
.config/hypr
.config/hypr/**
.config/mimeapps.list
.config/noctalia
.config/noctalia/**
.config/open-whispr
.config/open-whispr/**
.local/share/applications
.local/share/applications/**
{{- end }}

{{- if not (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch")) }}
.config/paru
.config/paru/**
{{- end }}

# WSL reuses the Unix CLI setup; the Windows host owns desktop and voice apps.
{{- if $isWSL }}
.chezmoiscripts/3-fix-openwhispr-hold.sh
.chezmoiscripts/4-configure-greetd-noctalia.sh
.config/alacritty
.config/alacritty/**
.config/ghostty
.config/ghostty/**
.config/kitty
.config/kitty/**
.config/wezterm
.config/wezterm/**
.config/fish/functions/asr-mode.fish
.config/fish/completions/asr-mode.fish
.local/bin/chezmoi-theme
{{- end }}

# McBopomofo is installed from the AUR and configured on Arch only.
{{- if or $isWSL (not (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch"))) }}
.config/fcitx5
.config/fcitx5/**
{{- end }}

# Noctalia-managed Qt colors are Arch-only.
{{- if or $isWSL (not (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch"))) }}
.config/qt6ct
.config/qt6ct/**
{{- end }}

# Matugen owns non-Linux palette generation.
{{- if not (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows")) }}
.chezmoiscripts/6-apply-theme.sh
.config/matugen
.config/matugen/**
{{- end }}

# Run scripts are platform-specific.
{{- if eq .chezmoi.os "windows" }}
.chezmoiscripts/*.sh
.local/bin/chezmoi-theme
{{- else }}
.chezmoiscripts/*.ps1
.local/bin/chezmoi-theme.cmd
{{- end }}
